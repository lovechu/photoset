# PhotoSet 后端配置示例
# 复制此文件为 .env 并填写实际配置

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=photoset
DB_CHARSET=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-strong-random-secret-key
JWT_EXPIRE_HOURS=24

# 存储配置
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_BUCKET=your_bucket
# S3_REGION=cn-hangzhou

# 支付宝配置（可选）
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/payment/success
ALIPAY_SANDBOX=true

# 微信支付配置（可选）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_merchant_id
WECHAT_API_KEY=your_wechat_api_key
WECHAT_CERT_PATH=/app/certs/wechat/apiclient_cert.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/wechat/notify

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=text